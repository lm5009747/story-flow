<xml xmlns="https://developers.google.com/blockly/xml"><variables></variables><block type="pxt-on-start" id="B*?@kXGwRZNf:!4J3D2o" x="20" y="20"><statement name="HANDLER"><block type="typescript_statement" id="4Z-mZXQ#w1SXZ{9Nl_s~"><mutation xmlns="http://www.w3.org/1999/xhtml" line0="namespace storyFlow {" line1="    let _currentPhase = 0;" line2="" line3="    /**" line4="     * Set the current story phase number." line5="     * Phase 1 = Intro Story, Phase 2 = Dialogue, Phase 3 = Gameplay." line6="     */" line7="    //% block=&quot;set story phase to %phase&quot;" line8="    //% group=&quot;Flow&quot;" line9="    export function setStoryPhase(phase: number) {" line10="        _currentPhase = phase;" line11="    }" line12="" line13="    /**" line14="     * Advance to the next story phase immediately." line15="     */" line16="    //% block=&quot;skip to next phase&quot;" line17="    //% group=&quot;Flow&quot;" line18="    export function skipToNextPhase() {" line19="        _currentPhase += 1;" line20="    }" line21="" line22="    /**" line23="     * Pauses the game, but breaks instantly if the story phase changes." line24="     * @param phase The phase this pause belongs to" line25="     * @param ms milliseconds to pause, eg: 1000" line26="     */" line27="    //% block=&quot;pause for %ms ms during phase %phase&quot;" line28="    //% group=&quot;Flow&quot;" line29="    export function phasePause(ms: number, phase: number) {" line30="        let steps = ms / 100;" line31="        for (let i = 0; i &lt; steps; i++) {" line32="            if (_currentPhase !== phase) {" line33="                break;" line34="            }" line35="            basic.pause(100);" line36="        }" line37="    }" line38="" line39="    /**" line40="     * Checks if the game is still on a specific story phase." line41="     */" line42="    //% block=&quot;is on phase %phase&quot;" line43="    //% group=&quot;Flow&quot;" line44="    export function isOnPhase(phase: number): boolean {" line45="        return _currentPhase === phase;" line46="    }" line47="}" numlines="48"></mutation></block></statement></block></xml>